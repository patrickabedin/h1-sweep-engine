[Unit]
Description=h1-sweep paper sampler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/engines/h1-sweep
EnvironmentFile=-/root/.engine-env
ExecStart=/usr/bin/python3 /opt/engines/h1-sweep/sampler.py --loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
